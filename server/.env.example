# Pick6 Server Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# PostgreSQL Database Connection
# For local development with Docker:
#   DATABASE_URL=postgresql://pick6:pick6local@localhost:5433/pick6
# For Supabase/hosted:
#   DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=postgresql://pick6:pick6local@localhost:5433/pick6

# JWT Secret for authentication tokens
# IMPORTANT: Change this in production! Use a long random string.
JWT_SECRET=pick6-super-secret-jwt-key-change-in-production

# ===========================================
# OPTIONAL - Have sensible defaults
# ===========================================

# Server port (default: 3001)
PORT=3001

# Node environment (development | production | test)
NODE_ENV=development

# CORS origin (default: * allows all origins)
# For production, set to your frontend URL: https://your-app.com
CORS_ORIGIN=*

# ===========================================
# EXTERNAL APIS - Required for automated scoring
# ===========================================

# The Odds API key for spread/favorite detection
# Sign up at https://the-odds-api.com/ to get a free API key
# Leave empty to disable automatic upset detection
ODDS_API_KEY=

# ESPN FBS group ID (default: 80 for FBS Division I)
ESPN_GROUP_ID=80

# Shared secret for scheduled syncs (GitHub Actions) - generate with: openssl rand -hex 24
ADMIN_SECRET=change-me-random-string

# ===========================================
# EMAIL - password reset links (Resend)
# ===========================================

# Leave empty locally: emails (reset links included) print to the server log
# instead of sending. Production sets it in the Render dashboard.
RESEND_API_KEY=
# Defaults: Pick 6 <noreply@pick6cfb.com>, and http://localhost:3000 for links
# (https://pick6cfb.com in production)
# EMAIL_FROM=
# APP_URL=

# ===========================================
# VIDEO MESSAGES - AI videos any league member can make (fal.ai, Stripe, Claude)
# ===========================================

# fal.ai API key (pay per use; a 38-second video cost $2.21). Leave empty
# and the video maker stays hidden.
FAL_KEY=
# Login emails who make videos for free, in any league they play in.
# Locally: smoke1@test.local. Everyone else pays once STRIPE_SECRET_KEY is set.
VIDEO_CREATORS=
# Stripe secret key: sk_test_... locally (card 4242 4242 4242 4242), live on
# Render. Leave empty and only the free list can make videos.
STRIPE_SECRET_KEY=
# Price per video in cents (default 350 = $3.50; Stripe's minimum is 50)
# VIDEO_PRICE_CENTS=350
# Anthropic API key for "Write it for me". Leave empty and the button is hidden.
ANTHROPIC_API_KEY=
# Model for the script draft (default claude-haiku-5-5, about a tenth of a
# cent a draft; claude-sonnet-5-5 ~1.5 cents and claude-opus-5-5 ~3 cents
# write sharper jokes)
# VIDEO_SCRIPT_MODEL=claude-haiku-5-5
