// Pick 6 schema — slot-based rosters, live snake draft, automated scoring.
// Game rules: 5 teams per player, one per ConferenceSlot; no two players may
// roster the same team in a league.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  leagueMembers LeagueMember[]
  draftPicks    DraftPick[]
  weeklyScores  WeeklyScore[]
  rosterSlots   RosterSlot[]
  draftQueues   DraftQueue[]
  swapClaims    SwapClaim[]
  leagueVideos  LeagueVideo[]
}

model League {
  id            Int      @id @default(autoincrement())
  name          String
  joinCode      String   @unique
  maxPlayers    Int
  draftComplete Boolean  @default(false)
  seasonYear    Int      @default(2026)
  createdAt     DateTime @default(now())

  // Draft configuration (set by commissioner)
  draftScheduledAt    DateTime?   // When draft is scheduled to begin (UTC)
  draftStatus         DraftStatus @default(NOT_STARTED)
  pickDeadlineSeconds Int         @default(90)

  // Draft state (runtime)
  draftStarted        Boolean   @default(false)
  draftStartTime      DateTime?
  currentPickNumber   Int       @default(0)
  currentPickDeadline DateTime?

  // Week-6 swap: members set private priority lists (SwapClaim) during
  // week 5; the scheduled sync runs every list once at the start of week 6,
  // worst record first. null = not run yet.
  swapRanAt DateTime?

  // Legacy: the turn-based week-5 window (retired Sep 30, 2026). Unused, but
  // kept so a rollback to the previous deploy still runs mid-season. Drop in
  // the offseason (NOTES.md).
  swapStatus       SwapStatus @default(NOT_OPEN)
  swapTurnDeadline DateTime?

  commissionerUserId Int?

  members      LeagueMember[]
  draftPicks   DraftPick[]
  weeklyScores WeeklyScore[]
  rosterSlots  RosterSlot[]
  draftQueues  DraftQueue[]
  swapClaims   SwapClaim[]
  videos       LeagueVideo[]
}

// AI video message from a commissioner to their league (Oct 5 prototype):
// photo + setting + voice + script, made into a talking video on fal.ai.
// Only the finished video's URL is kept (fal's CDN, set to never expire);
// the photo itself is never stored.
model LeagueVideo {
  id          Int               @id @default(autoincrement())
  leagueId    Int
  createdById Int
  setting     String // a VIDEO_SETTINGS id
  voice       String // a VIDEO_VOICES id
  script      String
  status      LeagueVideoStatus @default(PROCESSING)
  error       String? // why it failed, shown to its maker
  videoUrl    String?
  durationSec Float?
  sentAt      DateTime? // "Send to the league": the emails went out
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
}

enum LeagueVideoStatus {
  PROCESSING
  READY
  FAILED
}

enum DraftStatus {
  NOT_STARTED
  SCHEDULED
  LIVE
  PAUSED
  COMPLETE
}

enum SwapStatus {
  NOT_OPEN
  OPEN
  CLOSED
}

model LeagueMember {
  id       Int      @id @default(autoincrement())
  leagueId Int
  userId   Int
  joinedAt DateTime @default(now())

  // Draft order position (assigned when draft starts)
  draftPosition Int?

  role MemberRole @default(MEMBER)

  // Week-6 swap: each member gets at most one same-slot swap
  swapUsed    Boolean @default(false)
  swapSkipped Boolean @default(false) // legacy (turn-based window), unused
  swapOrder   Int? // run position, worst record first; set when the swap runs
  swapPoints  Int? // points through week 5 when the swap ran (set the order)
  swapSos     Int? // combined SOS rank when the swap ran (the tiebreaker)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
}

enum MemberRole {
  COMMISSIONER
  MEMBER
}

// The five draftable conference slots. NONE marks teams outside the player
// pool (FBS independents other than Notre Dame, FCS stub opponents).
enum ConferenceSlot {
  SEC
  BIG_TEN
  ACC_ND
  BIG_12
  G6
  NONE
}

model Team {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  conference      String
  slot            ConferenceSlot @default(NONE)
  abbreviation    String?
  espnTeamId      String? // ESPN's internal team ID for API matching
  espnDisplayName String? // ESPN display name for matching
  oddsApiName     String? // Name used by The Odds API for matching

  draftPicks   DraftPick[]
  rosterSlots  RosterSlot[]
  draftQueues  DraftQueue[]
  homeGames    Game[]       @relation("HomeTeam")
  awayGames    Game[]       @relation("AwayTeam")
  wonGames     Game[]       @relation("WinnerTeam")
  favoredGames Game[]       @relation("FavoriteTeam")
  swapDrops    SwapClaim[]  @relation("SwapClaimDrop")
  swapAdds     SwapClaim[]  @relation("SwapClaimAdd")
  sosRanks     TeamSos[]

  @@index([espnTeamId])
  @@index([oddsApiName])
}

model DraftPick {
  id          Int      @id @default(autoincrement())
  leagueId    Int
  userId      Int
  teamId      Int
  pickNumber  Int
  round       Int
  pickedAt    DateTime @default(now())
  wasAutoPick Boolean  @default(false)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([leagueId, pickNumber])
  @@unique([leagueId, teamId])
}

// User's draft queue - teams they want in priority order
model DraftQueue {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  userId    Int
  teamId    Int
  priority  Int // Lower number = higher priority
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([leagueId, userId, teamId])
  @@index([leagueId, userId, priority])
}

// Roster ownership with effective-week windows. A row is active while
// toWeek IS NULL; the week-6 swap closes the old row (toWeek = 5) and opens
// a new one (fromWeek = 6), so scoring week N always uses the roster that
// was active during week N.
//
// NOTE: two partial unique indexes exist in the migration SQL but cannot be
// expressed in Prisma schema syntax (Prisma has no partial-index support):
//   RosterSlot_active_team_key       (leagueId, teamId)        WHERE toWeek IS NULL
//   RosterSlot_active_user_slot_key  (leagueId, userId, slot)  WHERE toWeek IS NULL
// If you generate a future migration with `migrate dev`, review it so these
// indexes are not dropped as "drift".
model RosterSlot {
  id        Int            @id @default(autoincrement())
  leagueId  Int
  userId    Int
  slot      ConferenceSlot
  teamId    Int
  fromWeek  Int            @default(1)
  toWeek    Int? // null = currently on roster
  createdAt DateTime       @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  @@index([leagueId, userId])
  @@index([leagueId, teamId])
}

// One line of a member's week-6 swap list ("drop X, add Y"), in priority
// order. Private until the swap runs; the run then records each line's
// outcome. Only teams nobody owns when lists lock can be added, so a team
// dropped in the swap can't be picked up by anyone later in the order.
model SwapClaim {
  id         Int             @id @default(autoincrement())
  leagueId   Int
  userId     Int
  priority   Int // 1 = first choice
  dropTeamId Int
  addTeamId  Int
  status     SwapClaimStatus @default(PENDING)
  note       String? // why a MISSED claim didn't go through
  createdAt  DateTime        @default(now())

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropTeam Team   @relation("SwapClaimDrop", fields: [dropTeamId], references: [id])
  addTeam  Team   @relation("SwapClaimAdd", fields: [addTeamId], references: [id])

  @@unique([leagueId, userId, priority])
}

enum SwapClaimStatus {
  PENDING // waiting for the run
  SWAPPED // this line was the member's swap
  MISSED // not possible when the member's turn came (see note)
  UNUSED // a higher line already went through
}

// ESPN FPI strength of schedule for games already played (field avgsosrank,
// the SOS column on espn.com/college-football/fpi/_/view/resume): 1 = the
// hardest in FBS. Refreshed by the scheduled sync. Standings tiebreaker: on
// equal points, the lower combined rank of a member's five ranks higher.
model TeamSos {
  id         Int      @id @default(autoincrement())
  seasonYear Int
  teamId     Int
  sosRank    Int
  updatedAt  DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@unique([seasonYear, teamId])
}

model WeeklyScore {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  userId     Int
  weekNumber Int
  points     Int
  updatedAt  DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId, weekNumber])
}

// Game model for automated scoring with ESPN/Odds API integration
// (manual overrides go through POST /api/admin/game-override, which writes
// this table directly — the legacy GameResult side-table is gone)
model Game {
  id          Int    @id @default(autoincrement())
  espnEventId String @unique
  seasonYear  Int
  weekNumber  Int

  homeTeamId Int
  awayTeamId Int

  startTime DateTime
  status    GameStatus @default(SCHEDULED)

  homeScore Int?
  awayScore Int?

  winnerTeamId Int?

  // Odds/upset detection. wasUpset is only set when the winning underdog's
  // pre-game spread was +3.5 or more (league rule).
  spread         Float? // Home team spread (negative = home favored)
  homeMoneyline  Int?
  awayMoneyline  Int?
  favoriteTeamId Int?
  bookmaker      String?
  oddsTimestamp  DateTime?
  wasUpset       Boolean   @default(false)

  venue       String?
  neutralSite Boolean  @default(false) // ESPN's flag: "vs" for both teams, never "at"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeTeam     Team  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winnerTeam   Team? @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  favoriteTeam Team? @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id])

  @@index([seasonYear, weekNumber])
  @@index([startTime])
  @@index([status])
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
  CANCELLED
}

// ESPN's official week calendar (seasontype 2 only). The current week is
// DERIVED from the clock against these rows — never stored or advanced.
// Ingested from the ESPN calendar API once per season (D6).
model SeasonWeek {
  id         Int      @id @default(autoincrement())
  seasonYear Int
  weekNumber Int
  label      String
  startDate  DateTime
  endDate    DateTime

  @@unique([seasonYear, weekNumber])
  @@index([seasonYear, startDate])
}
